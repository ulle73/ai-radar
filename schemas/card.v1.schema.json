{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ulle73/ai-radar/schemas/card.v1.schema.json",
  "title": "AI Radar v2 – kort, kontraktsversion 1",
  "description": "Ett kort som domaren lämnar. Kontraktet beskriver formen; grindarna i scripts/lib/v2/gates.mjs avgör om kortet får publiceras.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "card_id",
    "area",
    "type",
    "title",
    "recommendation",
    "because",
    "analysis_mode",
    "observations",
    "anchors",
    "target",
    "test",
    "skeptic",
    "action_on_ok",
    "effort_hours",
    "monthly_cost_sek",
    "risk",
    "confidence",
    "dedupe_key",
    "expires_at"
  ],
  "properties": {
    "contract_version": { "const": 1 },
    "card_id": { "type": "string", "pattern": "^R2-[A-Za-z0-9-]{4,}$" },
    "area": { "enum": ["tools_hub", "social", "sales", "projects"] },
    "type": { "enum": ["NY", "ERSATT", "PROJEKT", "ANVAND", "LARM"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 120 },
    "recommendation": { "type": "string", "minLength": 10, "maxLength": 300 },
    "because": { "type": "string", "minLength": 20, "maxLength": 600 },
    "analysis_mode": { "enum": ["model", "fallback"] },
    "platform_news": { "type": "boolean" },
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "source_kind", "observed_at", "value", "verified"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "source_kind": { "enum": ["primary", "aggregator", "data", "social", "repo", "video", "transcript"] },
          "url": { "type": "string", "format": "uri" },
          "observed_at": { "type": "string", "format": "date-time" },
          "value": { "type": "string", "minLength": 1 },
          "verified": { "type": "boolean" }
        }
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/entity" }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "$ref": "#/$defs/entityKind" },
        "ref": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 }
      }
    },
    "replaces": { "type": ["string", "null"] },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "outcome", "verified"],
      "properties": {
        "kind": { "enum": ["smoke", "ab", "none"] },
        "task": { "type": "string" },
        "outcome": { "enum": ["pass", "fail", "not_run"] },
        "verified": { "type": "boolean" },
        "result": { "type": "string" },
        "artifacts": { "type": "array", "items": { "type": "string" } },
        "ab": {
          "type": "object",
          "additionalProperties": false,
          "required": ["old_result", "new_result", "criteria"],
          "properties": {
            "old_result": { "type": "string", "minLength": 1 },
            "new_result": { "type": "string", "minLength": 1 },
            "criteria": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "winner"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "winner": { "enum": ["new", "old", "tie"] }
                }
              }
            }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static_scan", "license", "clients"],
      "properties": {
        "static_scan": { "enum": ["clean", "findings", "not_run"] },
        "license": { "type": ["string", "null"] },
        "clients": {
          "type": "array",
          "items": { "enum": ["claude", "codex"] }
        },
        "client_note": { "type": "string" }
      }
    },
    "skeptic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "reason"],
      "properties": {
        "verdict": { "enum": ["PASS", "DOWNGRADE", "REJECT"] },
        "reason": { "type": "string", "minLength": 3 }
      }
    },
    "rule_text": { "type": ["string", "null"] },
    "urgency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "reason", "expires_at"],
      "properties": {
        "trigger": {
          "enum": ["competitor_campaign_live", "sales_deviation", "platform_breaking_change", "security_advisory"]
        },
        "reason": { "type": "string", "minLength": 3 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "action_on_ok": { "type": "string", "minLength": 5 },
    "effort_hours": { "type": "number", "minimum": 0 },
    "monthly_cost_sek": { "type": "number", "minimum": 0 },
    "risk": { "type": "string", "minLength": 1 },
    "measure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["metric", "baseline", "check_after_days"],
      "properties": {
        "metric": { "type": "string", "minLength": 1 },
        "baseline": { "type": "string", "minLength": 1 },
        "check_after_days": { "type": "integer", "minimum": 1 }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "dedupe_key": { "type": "string", "minLength": 3 },
    "expires_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "entityKind": {
      "enum": ["skill", "tool", "mcp", "repo", "workflow", "notion", "metric", "agents_rule", "shopify_theme"]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "$ref": "#/$defs/entityKind" },
        "ref": { "type": "string", "minLength": 1 }
      }
    }
  }
}
